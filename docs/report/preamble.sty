% Hyperlinks + Refs (to be loaded last)
% =============================================================
\RequirePackage{xurl} % modern version of 'url' package
\RequirePackage[unicode,
            psdextra,
            colorlinks=true,
            linkcolor=linkblue,    % section/figure/table links
            citecolor=linkblue,    % citations
            urlcolor=linkblue,     % URLs
            filecolor=linkblue,    % file links
            pdfborder={0 0 0},     % ensure no boxes in some viewers
            breaklinks=true]{hyperref}

% bookmark is an extension of hyperref and must be loaded after it
\RequirePackage{bookmark}

