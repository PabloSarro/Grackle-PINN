% =============================================================
% Word Counter
% =============================================================
\RequirePackage{verbatim}

\newcommand{\quickwordcount}{%
  % we use our actual 'main.tex' filename here
  \immediate\write18{texcount -merge -sum=1,1,1,1,0,0,0 -1 -q main.tex > \jobname-words.sum}%
  % -sum=X1,X2,X3,X4,X5,X6,X7
  % where X1=Text, X2=Header text, X3=Caption text, X4=Footnote text, X5=Inline math, X6=Displayed math, X7=Inlined math words
  \input{\jobname-words.sum}%
}
