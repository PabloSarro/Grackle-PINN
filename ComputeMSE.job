#!/bin/bash
#SBATCH --job-name=CompMSE
#SBATCH --time=00:03:00
#SBATCH --nodes=1
#SBATCH --ntasks=1
#SBATCH --cpus-per-task=4
#SBATCH --mem=8G
#SBATCH --account=master
#SBATCH --partition=gpu
#SBATCH --gres=gpu:1
#SBATCH --output=ComputeMSE.log

source EnvPablo/bin/activate

echo "Starting PINN training at $(date)"
python ComputeMSE.py
echo "Training finished at $(date)"