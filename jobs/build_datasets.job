#!/bin/bash
# Checks the regenerated ground truth and builds the .npz datasets. Account/QOS per TASKS.md 3.2.
#SBATCH --job-name=BuildData
#SBATCH --time=03:00:00
#SBATCH --nodes=1
#SBATCH --ntasks=1
#SBATCH --cpus-per-task=30
#SBATCH --mem=64G
#SBATCH --partition=gpu
#SBATCH --gres=gpu:1
#SBATCH --output=results/logs/build_datasets_%j.log

cd "$SLURM_SUBMIT_DIR"
source /home/sarro/venvs/grackle-pinn/bin/activate
GT=/scratch/izar/sarro/ground_truth
python scripts/datasets/check_ground_truth.py $GT/report8 $GT/balanced_valid $GT/balanced_train $GT/grid $GT/random15000
python scripts/datasets/build_datasets.py --gt $GT --out data/datasets
