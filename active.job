#!/bin/bash
#SBATCH --job-name=ActData
#SBATCH --time=00:30:00
#SBATCH --nodes=1
#SBATCH --ntasks=1
#SBATCH --cpus-per-task=1
#SBATCH --mem=8G
#SBATCH --account=master
#SBATCH --partition=gpu
#SBATCH --gres=gpu:1
#SBATCH --output=active.log
#SBATCH --error=active.err

source EnvPablo/bin/activate

echo "Starting PINN visualisation at $(date)"
python active.py 
echo "Visualisation finished at $(date)"